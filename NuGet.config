<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- BambuLab.X1Camera(.Imaging) and H264Sharp.Decoder live here. GitHub requires
         authentication for package downloads even when the packages are public: configure
         a user-level credential with a token carrying read:packages. Never commit one. -->
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHub-Wixely-Packages">
      <package pattern="BambuLab.X1Camera*" />
      <package pattern="H264Sharp.*" />
      <package pattern="Wixely.FluentFTP.BouncyCastle" />
    </packageSource>
  </packageSourceMapping>
</configuration>
